{
  "name": "record-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "rm -f .data/record-browser.db && pnpm db:migrate && pnpm db:seed",
    "user:create": "tsx scripts/create-user.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@nuxt/ui": "^4.10.0",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "better-sqlite3": "^13.0.1",
    "drizzle-orm": "^0.45.2",
    "elkjs": "^0.12.0",
    "gsap": "^3.15.0",
    "nuxt": "^4.5.0",
    "nuxt-auth-utils": "^0.5.29",
    "papaparse": "^5.5.4",
    "tailwindcss": "^4.3.3",
    "vue": "latest",
    "vue-router": "latest",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "vue-demi"
    ]
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.119",
    "@types/better-sqlite3": "^7.6.11",
    "@types/papaparse": "^5.3.15",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.0"
  }
}
